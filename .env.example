# ==========================================================
#  Uber Data Platform — Docker Compose configuration
#
#  Copy this file and adjust the values:
#      cp .env.example .env
#
#  `.env` at the repository root is gitignored. Docker Compose reads it
#  automatically for ${VARIABLE} substitution in docker-compose.yml.
# ==========================================================

# ----------------------------------------------------------
#  PostgreSQL
# ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=uber_db

# Host port mapped to the container's 5432.
# Defaults to 5433 so it does not clash with a local PostgreSQL install.
POSTGRES_HOST_PORT=5433

# ----------------------------------------------------------
#  Application ports
# ----------------------------------------------------------
BACKEND_PORT=5000
FRONTEND_PORT=8080

# ----------------------------------------------------------
#  SQL Assistant (required for /api/sql-assistant)
#  Get a key at https://openrouter.ai/keys
#  Leave empty to run the rest of the platform without the AI feature.
# ----------------------------------------------------------
OPENROUTER_API_KEY=

# ----------------------------------------------------------
#  Frontend build-time API base URL
#
#  Vite inlines this at BUILD time, so changing it requires a rebuild:
#      docker compose build frontend
#
#    http://localhost:5000  browser calls the API port directly (default)
#    /                      same-origin through the nginx reverse proxy
# ----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
